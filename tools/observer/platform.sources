@@ Looper.java
package android.os;
import java.util.concurrent.ExecutorService;
import java.util.concurrent.Executors;
/** 一个 worker 一条串行队列，daemon 不阻塞独立 JVM 退出。 */
public final class Looper {
    /** 模拟该 Looper 的调度队列。 */
    final ExecutorService queue = Executors.newSingleThreadExecutor(task -> {
        Thread thread = new Thread(task, "observer-fixture-worker");
        thread.setDaemon(true);
        return thread;
    });
}

@@ IBluetoothGatt.java
package android.bluetooth;
import android.os.IBinder;
import java.util.ArrayList;
import java.util.List;
/** 每次系统 GATT 服务重建拥有新 binder，旧 binder 可明确失效。 */
public final class IBluetoothGatt implements IBinder, android.os.IInterface {
    /** 当前 binder 是否存活。 */
    private boolean alive = true;
    /** 生产代码注册的死亡监听。 */
    private final List<DeathRecipient> deaths = new ArrayList<>();
    /** Android AIDL 接口的 binder 入口。 */
    public IBinder asBinder() { return this; }
    /** 只返回平台状态，不清理业务缓存。 */
    @Override public boolean isBinderAlive() { return alive; }
    /** 记录生产监听。 */
    @Override public void linkToDeath(DeathRecipient recipient, int flags) { deaths.add(recipient); }
    /** 删除生产监听。 */
    @Override public boolean unlinkToDeath(DeathRecipient recipient, int flags) { return deaths.remove(recipient); }
    /** 注入死亡信号，是否处理完全由生产代码决定。 */
    public void die() { alive = false; for (DeathRecipient callback : List.copyOf(deaths)) callback.binderDied(); }
}

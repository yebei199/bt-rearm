@@ Context.java
package android.content;
import android.bluetooth.BluetoothManager;
import java.util.ArrayList;
import java.util.List;
/** 只向生产实际注册过的广播接收器投递。 */
public class Context {
    /** 系统服务名称。 */
    public static final String BLUETOOTH_SERVICE = "bluetooth", INPUT_SERVICE = "input";
    /** 应用私有存储模式，仅参与完整类编译。 */
    public static final int MODE_PRIVATE = 0;
    /** 平台 receiver 注册记录。 */
    private final List<BroadcastReceiver> receivers = new ArrayList<>();
    /** 每次注册对应的过滤器。 */
    private final List<IntentFilter> filters = new ArrayList<>();
    /** 本场景无需切换 application context。 */
    public Context getApplicationContext() { return this; }
    /** 观察器只需要蓝牙 manager。 */
    public Object getSystemService(String name) { return name.equals(BLUETOOTH_SERVICE) ? new BluetoothManager() : null; }
    /** 通知路径不进入本测试。 */
    public <T> T getSystemService(Class<T> type) { return null; }
    /** 记录真实订阅，不自动增加状态 action。 */
    public Intent registerReceiver(BroadcastReceiver receiver, IntentFilter filter) {
        receivers.add(receiver); filters.add(filter); return null;
    }
    /** 实际按 filter 分发，缺失订阅会暴露在业务断言中。 */
    public void broadcast(Intent intent) {
        for (int i = 0; i < receivers.size(); i++) {
            if (filters.get(i).actions.contains(intent.getAction())) receivers.get(i).onReceive(this, intent);
        }
    }
    /** 存储路径不进入本测试。 */
    public SharedPreferences getSharedPreferences(String name, int mode) { return null; }
}

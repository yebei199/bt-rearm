    /** Looper 构造时已准备好队列。 */
    public void start() {}
    /** 交出该线程的队列。 */
    public Looper getLooper() { return looper; }
}
@@ Handler.java
package android.os;
import java.util.concurrent.CountDownLatch;
import java.util.concurrent.TimeUnit;
/** 即时任务串行运行，延时任务不自动触发，测试不依赖墙钟。 */
public final class Handler {
    /** 当前调度队列。 */
    private final Looper looper;
    /** 已执行任务的异常必须暴露，Executor不能静默吞掉。 */
    private final java.util.List<Throwable> failures = new java.util.concurrent.CopyOnWriteArrayList<>();
    /** 默认 handler 也拥有独立 worker。 */
    public Handler() { this(new Looper()); }
    /** 绑定生产构造提供的循环。 */
    public Handler(Looper looper) { this.looper = looper; }
    /** 排入真实 Runnable，业务逻辑原样执行。 */
    public boolean post(Runnable task) {
        looper.queue.submit(() -> { try { task.run(); } catch (Throwable failure) { failures.add(failure); } });
        return true;
    }
    /** 定时器超出测试边界，不推进 fake 时间。 */
    public boolean postDelayed(Runnable task, long delay) { return true; }
    /** 等此前排入的回调执行完，超时只作为死锁失败上限。 */
    public void drain() throws Exception {
        CountDownLatch done = new CountDownLatch(1);
        post(done::countDown);
        if (!done.await(5, TimeUnit.SECONDS)) throw new AssertionError("worker did not drain");
        if (!failures.isEmpty()) throw new AssertionError("worker callback failed", failures.get(0));
    }
}

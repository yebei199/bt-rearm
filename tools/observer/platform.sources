package android.content;
import java.util.HashMap;
import java.util.Map;
/** 只保存测试注入的广播负载。 */
public final class Intent {
    /** 通知代码编译需要的平台标志。 */
    public static final int FLAG_ACTIVITY_NEW_TASK = 0x10000000;
    /** 当前 action。 */
    private String action;
    /** 原样的 extra 值。 */
    private final Map<String, Object> extras = new HashMap<>();
    /** 按 action 创建广播。 */
    public Intent(String action) { this.action = action; }
    /** 通知路径不运行。 */
    public Intent(Context context, Class<?> type) {}
    /** 原样返回 action。 */
    public String getAction() { return action; }
    /** 保留 extra 类型和值。 */
    public Intent putExtra(String name, Object value) { extras.put(name, value); return this; }
    /** 使用生产调用指定的类型。 */
    public <T> T getParcelableExtra(String name, Class<T> type) { return type.cast(extras.get(name)); }
    /** 状态未提供时返回平台 default。 */
    public int getIntExtra(String name, int fallback) { return (int) extras.getOrDefault(name, fallback); }
    /** 通知路径不运行。 */
    public Intent addFlags(int flags) { return this; }
}

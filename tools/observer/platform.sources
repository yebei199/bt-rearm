package android.os;
/** Binder 传输边界，只模拟可用身份和死亡通知。 */
public interface IBinder {
    /** 平台的死亡回调形状。 */
    interface DeathRecipient { void binderDied(); }
    /** 默认活着，具体测试 binder 覆盖。 */
    default boolean isBinderAlive() { return true; }
    /** 默认活着，具体测试 binder 覆盖。 */
    default boolean pingBinder() { return isBinderAlive(); }
    /** 记录调用方注册的死亡监听。 */
    default void linkToDeath(DeathRecipient recipient, int flags) {}
    /** 删除调用方注册的死亡监听。 */
    default boolean unlinkToDeath(DeathRecipient recipient, int flags) { return true; }
}

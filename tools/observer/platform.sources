@@ IPrivilegedConnect.java
package io.github.yebei199.btrearm;
import android.os.IBinder;
/** 仅替代生成 AIDL 的传输壳，方法在真实服务实现中执行。 */
public interface IPrivilegedConnect {
    /** 真实服务公开入口。 */
    String connect(String mac) throws Exception;
    /** 真实服务公开入口。 */
    String watchLink(String mac) throws Exception;
    /** 真实服务公开入口。 */
    int lastDisconnectReason(String mac) throws Exception;
    /** 真实服务观察器失效入口。 */
    void invalidateObservers() throws Exception;
    /** 真实服务ACL退休入口。 */
    int retireConnection(String mac) throws Exception;
    /** 真实服务公开入口。 */
    void destroy() throws Exception;
    /** 与 Android 生成的 Stub 保持形状。 */
    abstract class Stub implements IPrivilegedConnect, IBinder {
        /** 只把 binder 壳转回当前接口，不改结果。 */
        public static IPrivilegedConnect asInterface(IBinder binder) { return (IPrivilegedConnect) binder; }
        /** 当前传输身份。 */
        public IBinder asBinder() { return this; }
    }
}
@@ Shizuku.java
package rikka.shizuku;
import android.content.ComponentName;
import android.content.ServiceConnection;
import android.os.IBinder;
/** 只驱动真实绑定回调，不参与 tuned 等业务缓存。 */
public final class Shizuku {
    /** 测试提供的用户服务身份。 */
    public static IBinder service;
    /** 业务注册的绑定回调。 */
    private static ServiceConnection connection;
    /** 业务注册的死亡回调。 */
    private static Runnable death;
    /** 业务注册的 ready 回调。 */
    private static Runnable ready;
    /** 版本输入可供下一阶段审查。 */
    public static int boundVersion;
    /** Shizuku 可用且已授权是这里的前提。 */
    public static boolean isPreV11() { return false; }
    /** 权限处理不在本轮。 */
    public static int checkSelfPermission() { return 0; }
    /** 绑定器活着时接口可用。 */
    public static boolean pingBinder() { return service != null; }
    /** sticky 语义驱动真实 init 到 bind。 */
    public static void addBinderReceivedListenerSticky(Runnable callback) { ready = callback; callback.run(); }
    /** 记录真实死亡处理。 */
    public static void addBinderDeadListener(Runnable callback) { death = callback; }
    /** 权限回调形状。 */
    public interface PermissionListener { void onRequestPermissionResult(int code, int result); }
    /** 已授权场景不会调用权限回调。 */
    public static void addRequestPermissionResultListener(PermissionListener callback) {}
    /** 不弹任何权限窗口。 */
    public static void requestPermission(int code) { throw new AssertionError("unexpected permission request"); }
    /** 保留用户服务参数链的形状。 */
    public static final class UserServiceArgs {
        /** 保存真实生产传入版本。 */
        int version;
        /** 接受真实 component 参数。 */
        public UserServiceArgs(ComponentName component) {}
        /** 保留进程名配置。 */
        public UserServiceArgs processNameSuffix(String suffix) { return this; }
        /** 记录配置的版本。 */
        public UserServiceArgs version(int version) { this.version = version; return this; }
        /** 保留守护配置。 */
        public UserServiceArgs daemon(boolean daemon) { return this; }
    }
    /** 绑定真实服务，通过业务回调完成连接。 */
    public static void bindUserService(UserServiceArgs args, ServiceConnection callback) {
        boundVersion = args.version; connection = callback; callback.onServiceConnected(null, service);
    }
    /** 模拟服务断开和新实例绑定，无业务缓存操作。 */
    public static void replace(IBinder replacement) {
        connection.onServiceDisconnected(null); service = replacement; ready.run();
    }
    /** 模拟无 disconnected 回调的 binder 死亡和重新到位。 */
    public static void dieAndRestore(IBinder replacement) {
        death.run(); service = replacement; ready.run();
    }
}

@@ PlatformViolations.java
package io.github.yebei199.btrearm;
import java.util.ArrayList;
import java.util.List;
/** 即使生产catch(Throwable)吞下异常，也不能吞掉观察器越界的记录。 */
public final class PlatformViolations {
    /** 当前独立JVM内的越界动作。 */
    public static final List<String> attempts = new ArrayList<>();
    /** 同时记录和拒绝动作，结果仍由真实业务调用决定。 */
    public static AssertionError forbidden(String action) { attempts.add(action); return new AssertionError(action); }
}

@@ IInterface.java
package android.os;
/** 真实Android的AIDL接口通过asBinder交出底层传输身份。 */
public interface IInterface {
    /** 不能直接把远端接口强转成IBinder。 */
    IBinder asBinder();
}

package android.bluetooth.le;
import java.util.List;
/** 观察器不得发起扫描。 */
public final class BluetoothLeScanner {
    /** 扫描启动即越过观察器范围。 */
    public void startScan(List<ScanFilter> filters, ScanSettings settings, ScanCallback callback) {
        throw io.github.yebei199.btrearm.PlatformViolations.forbidden("observer started scan");
    }
    /** 扫描停止即越过观察器范围。 */
    public void stopScan(ScanCallback callback) { throw io.github.yebei199.btrearm.PlatformViolations.forbidden("observer stopped scan"); }
}

@@ BluetoothGatt.java
package android.bluetooth;
import android.content.AttributionSource;
import android.os.Handler;
import java.util.ArrayList;
import java.util.List;
/** GATT 系统边界，记录真实业务发出的对象、附着参数和关闭次数。 */
public final class BluetoothGatt {
    /** 平台成功码。 */
    public static final int GATT_SUCCESS = 0;
    /** 构造出的所有对象，不能被 fixture 自动回收。 */
    public static final List<BluetoothGatt> created = new ArrayList<>();
    /** 下一次注册的返回值或异常输入。 */
    public static boolean accept = true, throwOnRegister;
    /** 创建时的系统服务身份。 */
    public final IBluetoothGatt service;
    /** 创建时的配对设备对象。 */
    public final BluetoothDevice device;
    /** 创建时的传输与 PHY 参数。 */
    public final int transport, phy;
    /** opportunistic 必须为真。 */
    public final boolean opportunistic;
    /** 实际注册次数与实际关闭次数。 */
    public int registrations, closes;
    /** 实际注册的 autoConnect 值。 */
    public Boolean autoConnect;
    /** 生产传入的回调。 */
    public BluetoothGattCallback callback;
    /** 生产传入的调度队列。 */
    public Handler handler;
    /** 保留真实 hidden constructor，null/dead 服务无法创建可用对象。 */
    public BluetoothGatt(IBluetoothGatt service, BluetoothDevice device, int transport,
                         boolean opportunistic, int phy, AttributionSource attribution) {
        if (service == null || !service.isBinderAlive()) throw new IllegalStateException("GATT service unavailable");
        this.service = service; this.device = device; this.transport = transport;
        this.opportunistic = opportunistic; this.phy = phy;
        created.add(this);
    }
    /** 模拟系统注册，记录参数，不替业务代码建立缓存。 */
    public boolean connect(Boolean autoConnect, BluetoothGattCallback callback, Handler handler) {
        this.autoConnect = autoConnect; this.callback = callback; this.handler = handler;
        registrations++;
        if (throwOnRegister) throw new IllegalStateException("registration failed");
        return accept;
    }
    /** 所有主动连接路径立即失败。 */
    public boolean connect() { throw io.github.yebei199.btrearm.PlatformViolations.forbidden("observer initiated connection"); }
    /** 所有参数写入路径立即失败。 */
    public boolean requestConnectionPriority(int priority) { throw io.github.yebei199.btrearm.PlatformViolations.forbidden("observer changed parameters"); }
    /** 所有 PHY 写入路径立即失败。 */
    public void setPreferredPhy(int tx, int rx, int options) { throw io.github.yebei199.btrearm.PlatformViolations.forbidden("observer changed PHY"); }
    /** 仅记录实际关闭动作，不能删除业务条目。 */
    public void close() { closes++; }
    /** 交出真实配对记录对象。 */
    public BluetoothDevice getDevice() { return device; }
    /** 旧对象关闭后仍能产生迟到回调，按注册的 worker 排队。 */
    public void emit(int reason, int state) throws Exception {
        if (callback == null || handler == null) throw new AssertionError("no registered callback");
        handler.post(() -> callback.onConnectionStateChange(this, reason, state));
        handler.drain();
    }
}

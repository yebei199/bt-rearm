<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- API 31 起蓝牙操作(connectGatt、getBondedDevices)走这颗运行期权限。 -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- 盯广播的 BLE 扫描。neverForLocation:不做定位推断,免去位置权限。 -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <!-- API 30 及以下的旧权限,minSdk 26 覆盖到的老设备用。 -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- 保活服务。connectedDevice 类型对 targetSdk 34 是强制声明的。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <application
        android:label="蓝牙布防"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|uiMode|density|smallestScreenSize">
            <!-- NativeActivity 加载这个库,android-activity 胶水随后调 android_main。 -->
            <meta-data
                android:name="android.app.lib_name"
                android:value="btrearm" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 与 Activity 同进程,只是保活凭据。不导出 —— 没有跨进程客户端。 -->
        <service
            android:name=".RearmService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Shizuku 靠它把绑定器递进来,是借 shell 身份连接的前提。 -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
